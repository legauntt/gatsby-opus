{
	"routes": [
		{
			"route": "/tonyai",
			"rewrite": "/tonyai/index.html",
			"headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" }
		},
		{
			"route": "/tonyai/*",
			"headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" }
		}
	],
	"responseOverrides": {
		"404": {
			"rewrite": "/index.html"
		}
	}
}
